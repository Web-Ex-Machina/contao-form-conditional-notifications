{
    "name": "webexmachina/contao-form-conditional-notifications",
    "description": "Form Conditional Notifications for Contao Open Source CMS",
    "keywords": ["form", "notification center", "email", "webexmachina", "module", "contao"],
    "type": "contao-bundle",
    "license": "LGPL-3.0+",
    "authors": [
        {
            "name": "Web ex Machina",
            "homepage": "https://www.webexmachina.fr",
            "role":"Developer"
        }
    ],
    "support":{
        "website": "https://www.webexmachina.fr",
        "issues": "https://github.com/web-ex-machina/contao-form-conditional-notifications/issues",
        "source": "https://github.com/web-ex-machina/contao-form-conditional-notifications"
    },
    "require": {
        "php": "^8.4",
        "contao/core-bundle": "^5.7",
        "codefog/contao-haste": "^5.4",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "terminal42/dcawizard": "^5.0",
        "terminal42/notification_center": "^2.7"
    },
    "autoload":{
        "psr-4": {
            "WEM\\FormConditionalNotificationsBundle\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "contao-community-alliance/composer-plugin": true,
            "php-http/discovery": false,
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    },
    "extra":{
        "contao-manager-plugin": "WEM\\FormConditionalNotificationsBundle\\ContaoManager\\Plugin"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "contao/easy-coding-standard": "@stable",
        "rector/rector": "@stable",
        "phpstan/phpstan": "@stable",
        "contao/contao-rector": "dev-main"
    }
}
